SUI_PROJECT_NAME=fanz-sui
FANZ_NETWORK=fanz-net

# Generate independently for each deployment.
# Example:
# openssl rand -hex 32
FANZ_SUI_API_TOKEN=replace-me

# Adapter mode is deliberately mock by default.
# Do not use testnet mode without a dedicated testnet signer.
FANZ_SUI_MODE=mock

# Used only when FANZ_SUI_MODE=testnet.
SUI_NETWORK=testnet
SUI_GRPC_URL=https://fullnode.testnet.sui.io:443

# Testnet signing secret only.
# Never commit this value.
# FANZ_SUI_TESTNET_PRIVATE_KEY=suiprivkey1...

# Testnet lifecycle gates.
# Preparation signs a transaction but does NOT broadcast it.
FANZ_SUI_TESTNET_PREPARE_ENABLED=false

# Submission broadcasts an already-persisted signed transaction.
# Keep false until explicit controlled testing.
FANZ_SUI_TESTNET_SUBMIT_ENABLED=false
