# FANZ application
SECRET_KEY=replace-with-a-strong-random-secret
DEBUG=False
ALLOWED_HOSTS=fanz.example.com,www.fanz.example.com
CSRF_TRUSTED_ORIGINS=https://fanz.example.com,https://www.fanz.example.com

# PostgreSQL
POSTGRES_DB=fanz
POSTGRES_USER=fanz
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://fanz:replace-with-a-strong-database-password@db:5432/fanz

# Auction settings
AUCTION_DURATION_DAYS=7
AUCTION_RELIST_DAYS=7

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
DEFAULT_FROM_EMAIL=FANZ <noreply@fanz.example.com>

# Deployment
FANZ_HTTP_PORT=8085
FANZ_NETWORK=fanz-net

# AI providers
OLLAMA_URL=http://host.docker.internal:11434/api/chat
OLLAMA_MODEL=gemma3:latest
OPENAI_API_KEY=
OPENAI_COMPANION_MODEL=gpt-4.1-mini

# Deployment identity
# Use a unique value when multiple FANZ deployments share one Docker host.
FANZ_PROJECT_NAME=fanz
