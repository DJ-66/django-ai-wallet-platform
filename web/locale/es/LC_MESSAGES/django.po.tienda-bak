msgstr "Fija esta actualización en la parte superior de mi página de empresa."

#: templates/businesses/my_businesses.html:4
#: templates/businesses/my_businesses.html:11
msgid "My Businesses"
msgstr "Minhas Empresas"

#: templates/businesses/my_businesses.html:14
msgid ""
"Manage your businesses, publish updates, create events, and grow your "
"community."
msgstr ""
"Gestiona tus negocios, publica actualizaciones,crea eventos y haz crecer tu "
"comunidad."

#: templates/businesses/my_businesses.html:26
msgid "Add Business"
msgstr "Agregar negocio"

#: templates/businesses/my_businesses.html:73
msgid "Create Event"
msgstr "Crear evento"

#: templates/businesses/my_businesses.html:85
msgid "Edit Business"
msgstr "Editar negocio"

#: templates/businesses/my_businesses.html:95
msgid "Grow My Business"
msgstr "Hacer crecer mi negocio"

#: templates/businesses/widgets/business_image_input.html:8
msgid "Current image:"
msgstr "Imagen actual:"

#: templates/businesses/widgets/business_image_input.html:31
msgid "Remove current image"
msgstr "Eliminar la imagen actual"

#: templates/businesses/widgets/business_image_input.html:48
msgid "Choose a new image"
msgstr "Elige una nueva imagen"

#: templates/businesses/widgets/business_image_input.html:50
msgid "Choose Image"
msgstr "Elegir imagen"

#: templates/emails/email_base.html:29
msgid "IA Para Todos — AI for Everyone"
msgstr "IA Para Todos — IA para Todos"

#: templates/emails/email_base.html:32
msgid "Helping creators, businesses, and communities grow with AI."
msgstr "Ayudando a creadores, empresas y comunidades a crecer con IA."

#: templates/signup_check_email.html:5
msgid "Check your email"
msgstr "Revisa tu correo electrónico."

#: templates/signup_check_email.html:8
msgid ""
"We sent you an activation link. Click it to activate your account and "
"receive 50 free credits."
msgstr ""
"Te hemos enviado un enlace de activación. Haz clic en él para activar tu "
"cuenta y recibir 50 créditos gratuitos."

#: templates/socialaccount/login.html:10
msgid "You are about to sign in using your Google account."
msgstr "Está a punto de iniciar sesión con su cuenta de Google."

#: templates/socialaccount/login.html:23
msgid "Back to login"
msgstr "Volver a iniciar sesión"

