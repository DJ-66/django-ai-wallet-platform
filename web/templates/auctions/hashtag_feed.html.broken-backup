{% extends "base.html" %}
{% load hashtag_tags %}
{% load i18n %}
{% load static %}
{% block content %}


<div class="hashtag-page">

    <div class="hashtag-card">
        <h3>🔥 {{ total_hashtags }} Hashtags on FANZ</h3>
        <div class="hashtag-chip-row">
            <a
        class="hashtag-chip"
        href="{% url 'discovery_hub_detail' slug='auctions' %}?lang=en"
        >
        #auctions ({{ live_auction_count }})
        </a>
            {% for tag in trending_hashtags %}
                <a href="{% url 'hashtag_feed' tag.name %}" class="hashtag-chip">
                    #{{ tag.name }} ({{ tag.usage_count }})
                </a>
            {% empty %}
                <span>No trending hashtags yet.</span>
            {% endfor %}
        </div>
    </div>

    <div class="hashtag-card">
       <h2 class="hashtag-title">#{{ hashtag.name }}</h2>

{% if hashtag.name == "discover_fanz" %}
    {% get_current_language as LANGUAGE_CODE %}

    {% if LANGUAGE_CODE == "es" %}
        <img
            src="{% static 'auctions/img/ES-50-FREE.webp' %}"
            alt="50 créditos gratis en Fanz.to"
            class="discover-fanz-banner-img"
            width="686"
            height="936"
        >
    {% else %}
        <img
            src="{% static 'auctions/img/EN-50-FREE.webp' %}"
            alt="Fifty Free Credits on Fanz.to"
            class="discover-fanz-banner-img"
            width="686"
            height="930"
        >
    {% endif %}

{% if auction_page.object_list %}
<section class="hashtag-auctions-section">
    <div class="discovery-section-heading discovery-section-heading-row">
        <div>
            <h2>Live Auctions in #{{ hashtag.name }}</h2>

            <p>
                Platform auctions tagged
                <strong>#{{ hashtag.name }}</strong>,
                ordered by ending soonest.
            </p>
        </div>

        <a
            class="discovery-section-cta"
            href="{% url 'discovery_hub_detail' slug='auctions' %}?lang=en"
        >
            Explore Auction Discovery
        </a>
    </div>

    <div class="auction-grid">
        {% for auction in auction_page %}
            {% include "auctions/includes/_auction_card.html" with auction=auction %}
        {% endfor %}
    </div>
 {% endif %}

<div style="display:flex;justify-content:space-between;align-items:center;margin-top:10px;">

    <p style="margin:0;">
        {{ hashtag.usage_count }} posts tagged
    </p>

    <a
        class="feed-like-btn telegram-share-btn"
        href="https://t.me/share/url?text=%23{{ hashtag.name|urlencode }}%20on%20FANZ&url={{ request.scheme }}://{{ request.get_host }}{{ request.path }}"
        target="_blank"
        rel="noopener noreferrer"
    >
        📲 Telegram
    </a>

</div>
    

</div>

{% if auction_page.object_list %}
<section class="hashtag-auctions-section">
    <div class="discovery-section-heading discovery-section-heading-row">
        <div>
            <h2>Live Auctions in #{{ hashtag.name }}</h2>

            <p>
                Platform auctions tagged
                <strong>#{{ hashtag.name }}</strong>,
                ordered by ending soonest.
            </p>
        </div>

        <a
            class="discovery-section-cta"
            href="{% url 'discovery_hub_detail' slug='auctions' %}?lang=en"
        >
            Explore Auction Discovery
        </a>
    </div>

    <div class="auction-grid">
        {% for auction in auction_page %}
            {% include "auctions/includes/_auction_card.html" with auction=auction %}
        {% endfor %}
    </div>

    {% if auction_page.paginator.num_pages > 1 %}
        <nav
            class="discovery-pagination"
            aria-label="Auction pagination"
        >
            {% if auction_page.has_previous %}
                <a
                    href="?auction_page={{ auction_page.previous_page_number }}"
                >
                    ← Previous
                </a>
            {% endif %}

            <span>
                Page {{ auction_page.number }}
                of {{ auction_page.paginator.num_pages }}
            </span>

            {% if auction_page.has_next %}
                <a
                    href="?auction_page={{ auction_page.next_page_number }}"
                >
                    Next →
                </a>
            {% endif %}
        </nav>
    {% endif %}
</section>
{% endif %}

    {% for post in posts %}
        <div class="hashtag-post">
           <strong>
  <a href="{% url 'public_profile_root' post.user.username %}" class="post-author-link">
    @{{ post.user.username }}
  </a>
</strong>
         {% if post.title %}
    <h3 class="feed-post-title">{{ post.title }}</h3>
{% endif %}

{% if post.is_paid and request.user != post.user and post.id not in unlocked_post_ids %}
    <div class="locked-post-card">

        {% if post.image %}
            <div class="premium-preview">
                <img src="{{ post.image.url }}" class="feed-image premium-blur">
                <div class="premium-overlay">
                    🔒 {% trans "Premium Content" %}
                </div>
            </div>
        {% endif %}

        <p class="locked-post-title">
            🔒 {% trans "Premium content locked" %}
        </p>

        <p class="locked-post-price">
            {% trans "Unlock media for" %} {{ post.unlock_price }} {% trans "credits" %}
        </p>

        <form method="post" action="{% url 'unlock_feed_post' post.id %}">
            {% csrf_token %}
            <button type="submit" class="auth-primary-btn">
                {% trans "Unlock Post" %}
            </button>
        </form>

    </div>
{% else %}
    <p>{{ post.content|link_hashtags|linebreaksbr }}</p>
     {% include "auctions/includes/_post_media.html" with post=post %}

{% endif %}

<div class="post-actions">
    <a href="{% url 'post_detail' post.id %}" class="view-post-link">
        View post →

    </a>
</div>
            
        </div>
    {% empty %}
        <div class="hashtag-card">
            No posts found.
        </div>
    {% endfor %}

</div>

{% endblock %}
