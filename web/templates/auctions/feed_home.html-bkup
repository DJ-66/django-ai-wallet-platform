{% extends "base.html" %}
{% load static %}
{% load i18n %}
{% load hashtag_tags %}
{% block content %}

<div class="feed-page">

    <div class="feed-layout">

        <div class="feed-compose-card">
            <h2>{% trans "Community Feed" %}</h2>

            <form method="post"
                enctype="multipart/form-data"
                class="feed-form prevent-double-submit">            
           
            {% csrf_token %}

            {% if form.errors %}
    <div class="feed-form-error-banner">
        <strong>
            ⚠️ {% trans "Your post could not be published." %}
        </strong>

        {% for error in form.non_field_errors %}
            <p>{{ error }}</p>
        {% endfor %}

        {% for error in form.images.errors %}
            <p>{{ error }}</p>
        {% endfor %}

        {% for field in form %}
            {% if field.name != "images" %}
                {% for error in field.errors %}
                    <p>{{ error }}</p>
                {% endfor %}
            {% endif %}
        {% endfor %}
    </div>
{% endif %}
            
            <div class="feed-compose-fields">
    <div class="feed-compose-field">
        {{ form.title }}
    </div>

    <div class="feed-compose-field">
        {{ form.content }}
    </div>
</div>

<div class="feed-media-section">
    <div class="feed-media-type-header">
        <div>
            <strong class="feed-section-title">
                {% trans "Media Type" %}
            </strong>

            <span class="feed-smart-upload-badge">
                ✨ {% trans "FANZ Smart Upload" %}
            </span>
        </div>

        <button
            type="button"
            class="feed-upload-rules-button"
            data-upload-rules-open
        >
            ⓘ {% trans "Upload Rules" %}
        </button>
    </div>

    <div class="feed-media-type-selector">
        {{ form.media_type }}
    </div>
</div>

<div class="feed-media-upload">
    <label
        id="feed-media-upload-label"
        for="{{ form.images.id_for_label }}"
        class="feed-media-upload-button"
    >
        <span class="feed-media-upload-icon">📷</span>

        <span class="feed-media-upload-text">
            {% trans "Choose Images" %}
        </span>
    </label>

    {{ form.images }}

    <span
        id="selected-file-name"
        class="feed-selected-file-name"
    >
        {% trans "No files selected" %}
    </span>
</div>

<div class="feed-access-options">
    <label class="feed-access-option feed-public-option">
        {{ form.is_public }}

        <span class="feed-access-option-content">
            <span class="feed-access-option-icon">🌎</span>

            <span>
                <strong>{% trans "Public Post" %}</strong>
                <small>{% trans "Visible to the FANZ community" %}</small>
            </span>
        </span>
    </label>

    <label class="feed-access-option feed-premium-option">
        {{ form.is_paid }}

        <span class="feed-access-option-content">
            <span class="feed-access-option-icon">🔒</span>

            <span>
                <strong>{% trans "Paid / Locked Post" %}</strong>
                <small>{% trans "Require credits to unlock" %}</small>
            </span>
        </span>
    </label>
</div>

<div class="feed-unlock-price-section">
    <label
        for="{{ form.unlock_price.id_for_label }}"
        class="feed-unlock-price-label"
    >
        {% trans "Unlock Price" %}
    </label>

    <div class="feed-unlock-price-control">
        {{ form.unlock_price }}

        <span class="feed-unlock-price-suffix">
            {% trans "Credits" %}
        </span>
    </div>
</div>

<div class="feed-submit-row">
    <button
        type="submit"
        class="auth-primary-btn feed-action-btn"
        data-loading-text="⏳ Publishing..."
    >
        <span class="feed-submit-icon">🚀</span>
        <span>{% trans "Publish Post" %}</span>
    </button>
</div>
    </div>

    {{ form.media_type }}
</div>

            <div class="feed-media-upload">

    <label
        id="feed-media-upload-label"
        for="{{ form.images.id_for_label }}"
        class="feed-media-upload-button"
    >
        📷 Choose Images
    </label>

    {{ form.images }}

    <span id="selected-file-name">
        No files selected
    </span>

</div>

           

            <label class="feed-private-toggle">
            {{ form.is_public }}
            {% trans "Public Post" %}
            </label>

           <label class="feed-private-toggle">
    {{ form.is_paid }}
    {% trans "Paid / Locked Post (Premium)" %}
</label>



<label class="feed-unlock-price-label">
    {% trans "Unlock Price" %}
</label>

{{ form.unlock_price }}

           <button
           type="submit"
           class="auth-primary-btn feed-action-btn"
           data-loading-text="⏳ Publishing..."
           >
            {% trans "Post" %}
            </button>

            <br>

            </form>
            <br>
        </div>

        {% for item in feed_items %}

        {% if item.item_type == "post" %}
        {% include "auctions/includes/_feed_post.html" with post=item.object %}

        {% elif item.item_type == "business_update" %}
        {% include "auctions/includes/_business_update.html" with update=item.object %}

        {% elif item.item_type == "event" %}
        {% include "auctions/includes/_event.html" with event=item.object %}

        {% endif %}

        {% empty %}

        <div class="feed-post-card">
        <p>{% trans "No community activity yet." %}</p>
        </div>
        {% endfor %}

    </div>

</div>
<script>
document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".ajax-like-btn").forEach(function (button) {
        button.addEventListener("click", function () {
            const url = button.dataset.url;
            const postId = button.dataset.postId;

            fetch(url, {
                method: "GET",
                headers: {
                    "X-Requested-With": "XMLHttpRequest"
                }
            })
            .then(response => response.json())
            .then(data => {
                const countSpan = document.getElementById(`like-count-${postId}`);
                if (countSpan) {
                    countSpan.textContent = data.like_count;
                }
            })
            .catch(error => console.error("Like error:", error));
        });
    });
});
</script>

<script>
document.addEventListener("DOMContentLoaded", function () {

    document.querySelectorAll(".ajax-tip-btn").forEach(function (button) {

        button.addEventListener("click", function () {

            const url = button.dataset.url;
            const amount = button.dataset.amount;

            fetch(url, {
                method: "POST",

                body: JSON.stringify({
                    amount: amount
                }),

                headers: {
                    "X-Requested-With": "XMLHttpRequest",
                    "X-CSRFToken": getCookie("csrftoken"),
                    "Content-Type": "application/json",
                }
            })



            .then(response => response.json())
            .then(data => {

                if (data.success) {

                    button.innerHTML = "✅ {% trans 'Tipped' %}";

                    setTimeout(() => {
                        button.innerHTML = "💰 {% trans 'Thanks' %}";
                    }, 1500);

                } else {
                    alert(data.error || "{% trans 'Tip failed.' %}");
                }

            })
            .catch(error => {
                console.error("Tip error:", error);
            });

        });

    });

});


function getCookie(name) {
    let cookieValue = null;

    if (document.cookie && document.cookie !== "") {

        const cookies = document.cookie.split(";");

        for (let i = 0; i < cookies.length; i++) {

            const cookie = cookies[i].trim();

            if (cookie.substring(0, name.length + 1) === (name + "=")) {

                cookieValue = decodeURIComponent(
                    cookie.substring(name.length + 1)
                );

                break;
            }
        }
    }

    return cookieValue;
}
</script>

<script>
document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".post-comment-form").forEach(function (form) {
        form.addEventListener("submit", function (event) {
            event.preventDefault();

            const input = form.querySelector('input[name="content"]');
            const parentInput = form.querySelector('input[name="parent_id"]');
            const content = input.value.trim();

            if (!content) return;

            fetch(form.action, {
                method: "POST",
                body: new FormData(form),
                headers: {
                    "X-Requested-With": "XMLHttpRequest",
                    "X-CSRFToken": getCookie("csrftoken"),
                }
            })
            .then(response => response.json())
            .then(data => {
                if (!data.success) {
                    alert(data.error || "Comment failed.");
                    return;
                }

                const commentHtml = `
                    <div class="${data.parent_id ? "post-reply" : "post-comment"}">
                        <strong>@${data.username}</strong>
                        <p>${data.content}</p>
                    </div>
               

                if (data.parent_id) {
                    form.insertAdjacentHTML("beforebegin", commentHtml);
                } else {
                    form.insertAdjacentHTML("beforebegin", commentHtml);
                }

                input.value = "";
            })
            .catch(error => {
                console.error("Comment error:", error);
            });
        });
    });
});
</script>

<script>
document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".share-post-btn").forEach(function (button) {
        button.addEventListener("click", function () {
            const url = button.dataset.url;

            navigator.clipboard.writeText(url).then(() => {
                const originalText = button.innerHTML;
                button.innerHTML = "✅ {% trans 'Copied' %}";

                setTimeout(() => {
                    button.innerHTML = originalText;
                }, 1500);
            });
        });
    });
});
</script>
<script>
document.addEventListener("DOMContentLoaded", function () {

    const input = document.getElementById("id_images");
    const filename = document.getElementById("selected-file-name");

    if (input) {
        input.addEventListener("change", function () {
            filename.textContent =
                input.files.length
                    ? `${input.files.length} image(s) selected`
                    : "";
        });
    }

});
</script>
<div id="premiumUnlockModal" class="premium-unlock-modal" style="display:none;">
    <div class="premium-unlock-box">
        <h3>🔒 Unlock Premium Post?</h3>
        <p id="premiumUnlockText"></p>

        <div style="display:flex; gap:10px; justify-content:center; margin-top:18px;">
            <button type="button" id="cancelPremiumUnlock" class="auth-secondary-btn">
                Cancel
            </button>
            <button type="button" id="confirmPremiumUnlock" class="auth-primary-btn">
                Unlock Post
            </button>
        </div>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
    let pendingPremiumUnlockForm = null;

    document.querySelectorAll(".premium-unlock-trigger").forEach(function (button) {
        button.addEventListener("click", function () {
            pendingPremiumUnlockForm = button.closest("form");

            const title = button.dataset.postTitle || "Premium Post";
            const price = button.dataset.unlockPrice || "0";

            document.getElementById("premiumUnlockText").textContent =
                'Unlock "' + title + '" for ' + price + ' credits?';

            document.getElementById("premiumUnlockModal").style.display = "flex";
        });
    });

    document.getElementById("cancelPremiumUnlock").addEventListener("click", function () {
        pendingPremiumUnlockForm = null;
        document.getElementById("premiumUnlockModal").style.display = "none";
    });

    document.getElementById("confirmPremiumUnlock").addEventListener("click", function () {
        if (pendingPremiumUnlockForm) {
            pendingPremiumUnlockForm.submit();
        }
    });
});
</script>
<script>
document.addEventListener("DOMContentLoaded", function () {
    const mediaTypeInputs = document.querySelectorAll(
        'input[name="{{ form.media_type.html_name }}"]'
    );

    const fileInput = document.getElementById(
        "{{ form.images.id_for_label }}"
    );

    const uploadLabel = document.getElementById(
        "feed-media-upload-label"
    );

    const selectedFileName = document.getElementById(
        "selected-file-name"
    );

    const paidInput = document.getElementById(
        "{{ form.is_paid.id_for_label }}"
    );

    const unlockPriceInput = document.getElementById(
        "{{ form.unlock_price.id_for_label }}"
    );

    if (
        !mediaTypeInputs.length ||
        !fileInput ||
        !uploadLabel ||
        !selectedFileName ||
        !paidInput ||
        !unlockPriceInput
    ) {
        return;
    }

    const mediaSettings = {
        image: {
            label: "📷 Choose Images",
            accept: "image/jpeg,image/png,image/webp",
        },
        video: {
            label: "🎬 Choose Videos",
            accept: "video/mp4",
        },
        audio: {
            label: "🎵 Choose Audio Files",
            accept: "audio/mpeg,.mp3",
        },
        pdf: {
            label: "📄 Choose PDF Files",
            accept: "application/pdf,.pdf",
        },
    };

    function getSelectedMediaType() {
        const selectedInput = document.querySelector(
            'input[name="{{ form.media_type.html_name }}"]:checked'
        );

        return selectedInput ? selectedInput.value : "image";
    }

    function updateUploadControl() {
        const mediaType = getSelectedMediaType();
        const settings =
            mediaSettings[mediaType] || mediaSettings.image;

        uploadLabel.textContent = settings.label;
        fileInput.setAttribute("accept", settings.accept);

        fileInput.value = "";
        selectedFileName.textContent = "No files selected";
    }

    function updateSelectedFileCount() {
        const fileCount = fileInput.files
            ? fileInput.files.length
            : 0;

        if (fileCount === 0) {
            selectedFileName.textContent = "No files selected";
            return;
        }

        if (fileCount === 1) {
            selectedFileName.textContent = "1 file selected";
            return;
        }

        selectedFileName.textContent =
            `${fileCount} files selected`;
    }

    function syncPremiumFromPrice() {
        const price =
            Number.parseInt(unlockPriceInput.value, 10) || 0;

        if (price >= 1) {
            paidInput.checked = true;
        }
    }

    function requiredMinimumPrice() {
        const mediaType = getSelectedMediaType();
        const fileCount = fileInput.files
            ? fileInput.files.length
            : 0;

        if (mediaType === "image") {
            return fileCount > 3 ? 250 : 0;
        }

        if (
            mediaType === "video" ||
            mediaType === "audio" ||
            mediaType === "pdf"
        ) {
            if (fileCount >= 2) {
                return 250;
            }

            return fileCount >= 1 ? 1 : 0;
        }

        return 0;
    }

    function applyPremiumDefaults() {
        const minimumPrice = requiredMinimumPrice();

        if (minimumPrice <= 0) {
            return;
        }

        paidInput.checked = true;

        const currentPrice =
            Number.parseInt(unlockPriceInput.value, 10) || 0;

        if (currentPrice < minimumPrice) {
            unlockPriceInput.value = minimumPrice;
        }
    }

    mediaTypeInputs.forEach(function (input) {
        input.addEventListener(
            "change",
            function () {
                updateUploadControl();
                applyPremiumDefaults();
            }
        );
    });

    fileInput.addEventListener(
        "change",
        function () {
            updateSelectedFileCount();
            applyPremiumDefaults();
        }
    );

    unlockPriceInput.addEventListener(
        "input",
        syncPremiumFromPrice
    );

    unlockPriceInput.addEventListener(
        "change",
        syncPremiumFromPrice
    );

    updateUploadControl();
});


</script>

{% endblock %}
