{% extends "base.html" %}
{% load i18n %}
{% block content %}
<section class="business-update-form-page">
  <div class="business-update-form-card">

    <header class="business-update-form-header">
      <span class="business-update-form-badge">
        📣 {% trans "Business Update" %}

      </span>

      <h1>{% trans "Publish Update" %}</h1>

      <p>
        Share news, specials, announcements, or anything happening at
        <strong>{{ business.name }}</strong>.
      </p>
    </header>

    <form
      method="post"
      enctype="multipart/form-data"
      class="business-update-form"
    >
      {% csrf_token %}

      {% if form.non_field_errors %}
        <div class="business-update-form-errors">
          {{ form.non_field_errors }}
        </div>
      {% endif %}

      <div class="business-update-form-field">
        <label for="{{ form.title.id_for_label }}">
            {% trans "Update title" %}

        </label>

        {{ form.title }}

        {% if form.title.errors %}
          <div class="business-update-form-errors">
            {{ form.title.errors }}
          </div>
        {% endif %}
      </div>

      <div class="business-update-form-field">
        <label for="{{ form.body.id_for_label }}">
          {% trans "What’s happening?" %}

        </label>

        {{ form.body }}

        {% if form.body.errors %}
          <div class="business-update-form-errors">
            {{ form.body.errors }}
          </div>
        {% endif %}
      </div>

      <div class="business-update-form-field">
        <label>{% trans "Update image" %}</label>

        <div class="business-update-upload">
          <label
            for="{{ form.image.id_for_label }}"
            class="business-update-upload-button"
          >
            📷 {% trans "Choose an Image" %}
          </label>

          <span
            id="business-update-file-name"
            class="business-update-upload-name"
          >
            {% trans "No image selected" %}
          </span>

          {{ form.image }}
        </div>

         <p class="business-update-form-help">
         {% blocktrans trimmed %}
             Optional. JPEG, PNG, or WebP. Your image will be optimized,
             converted to WebP, and branded by FANZ.
         {% endblocktrans %}
         </p>
        
        {% if form.image.errors %}
          <div class="business-update-form-errors">
            {{ form.image.errors }}
          </div>
        {% endif %}

        <div class="business-update-form-field">
    <label class="business-update-checkbox">
        {{ form.is_featured }}
        <span>📌 {% trans "Pin this update to the top of my business page" %}
</span>
    </label>

    {% if form.is_featured.errors %}
        <div class="business-update-form-errors">
            {{ form.is_featured.errors }}
        </div>
    {% endif %}
</div>
      </div>

      <div class="business-update-form-actions">
        <button
          type="submit"
          class="business-update-publish-button"
        >
          📣 {% trans "Publish Update" %}
        </button>

        <a
          href="{% url 'businesses:detail' business.slug %}"
          class="business-update-cancel-button"
        >
          {% trans "Cancel" %}
        </a>
      </div>
    </form>

  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const fileInput = document.getElementById(
      "{{ form.image.id_for_label }}"
    );
    const fileName = document.getElementById(
      "business-update-file-name"
    );

    if (!fileInput || !fileName) {
      return;
    }

    fileInput.addEventListener("change", function () {
      if (fileInput.files && fileInput.files.length > 0) {
        fileName.textContent = fileInput.files[0].name;
      } else {
        fileName.textContent = fileName.dataset.emptyText;
      }
    });
  });
</script>
{% endblock %}
